# ---- Copy this file to backend/.env and fill in your key ----
# Demo mode (no key needed): EXTRACTION_PROVIDER=fixtures
# Live mode:                 EXTRACTION_PROVIDER=groq

EXTRACTION_PROVIDER=fixtures

# Required only when EXTRACTION_PROVIDER=groq.
# Get a key: https://console.groq.com/keys
# Copy a CURRENT model id: https://console.groq.com/docs/models
LLM_API_KEY=
EXTRACTION_MODEL=
# "object" works on every Groq model with JSON mode.
# Use "schema" only if your chosen model supports json_schema.
EXTRACTION_JSON_MODE=object

ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
MAX_PAGES=50
